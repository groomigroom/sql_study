SQL
-- (가)
SELECT C.고객번호 FROM 고객 C
WHERE C.고객번호 NOT IN (
  SELECT O.고객번호 FROM 주문 O
  WHERE O.고객번호 IS NOT NULL
);

-- (나)
SELECT C.고객번호 FROM 고객 C
WHERE C.고객번호 NOT IN (
  SELECT NVL(O.고객번호, 9999) FROM 주문 O
);

-- (다)
SELECT C.고객번호 FROM 고객 C
WHERE EXISTS (
  SELECT 1 FROM 주문 O
  WHERE C.고객번호 <> O.고객번호
);

-- (라)
SELECT C.고객번호 FROM 고객 C
WHERE NOT EXISTS (
  SELECT 1 FROM 주문 O
  WHERE C.고객번호 = O.고객번호
);
